        <mxCell id="n53" parent="1" value="Identity / least privilege / network reachability / auditing without sensitive payloads&#10;Input and output validation / tool-schema change control / trusted approvals for writes&#10;Broker JWT + upstream Entra validation / delegated scope / consent and redirect policy / no automatic OBO.&#10;MCP does not grant access, supply governance, eliminate hallucinations or imply autonomy." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#617182;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1">
