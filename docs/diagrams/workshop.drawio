        <mxCell id="server-types-47" parent="1" value="Need both in one workflow?" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#398E83;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="60" y="958" width="1660" height="32.199999999999996" />
        </mxCell>
        <mxCell id="server-types-48" parent="1" value="One compatible host can connect to multiple scoped MCP servers." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="997" width="1660" height="28.0" />
        </mxCell>
        <mxCell id="server-types-49" parent="1" value="" style="rounded=1;arcSize=8;fillColor=#FFFBF3;strokeColor=#A86B19;dashed=0;" vertex="1">
          <mxGeometry as="geometry" x="40" y="1083" width="1720" height="130" />
        </mxCell>
        <mxCell id="server-types-50" parent="1" value="Not every server is an MCP server" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=24;fontColor=#A86B19;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="60" y="1101" width="1660" height="33.599999999999994" />
        </mxCell>
        <mxCell id="server-types-51" parent="1" value="A REST endpoint returning JSON is not MCP unless it implements MCP messages, discovery and the relevant protocol contracts." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="1146" width="1660" height="26.599999999999998" />
        </mxCell>
        <mxCell id="server-types-52" parent="1" value="An MCP server need not contain an LLM. A REST service or database can sit behind it; an SDK supplies the MCP-facing layer." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="1178" width="1660" height="26.599999999999998" />
        </mxCell>
        <mxCell id="server-types-53" parent="1" value="Our demo: Copilot Studio → custom MCP server on Azure Container Apps → bundled character records." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#3178BF;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="40" y="1250" width="1700" height="29.4" />
        </mxCell>
        <mxCell id="server-types-54" parent="1" value="It proves the integration pattern, not Microsoft Azure MCP Server tool execution." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="40" y="1290" width="1700" height="28.0" />
        </mxCell>
        <mxCell id="server-types-55" parent="1" value="Reference: learn.microsoft.com/azure/developer/azure-mcp-server/overview" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="40" y="1334" width="1700" height="22.4" />
        </mxCell>
      </root>
    </mxGraphModel>
