          <mxGeometry as="geometry" x="40" y="949" width="840" height="113" />
        </mxCell>
        <mxCell id="fundamentals-47" parent="1" value="Server capabilities" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#273543;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="58" y="962" width="804" height="30.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-48" parent="1" value="Tools: callable functions. Resources: contextual data." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="58" y="1000" width="804" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-49" parent="1" value="Prompts: reusable templates. Not every server must expose all three." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="58" y="1028" width="804" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-50" parent="1" value="" style="rounded=1;arcSize=8;fillColor=#FBF8FE;strokeColor=#8658AD;dashed=0;" vertex="1">
          <mxGeometry as="geometry" x="920" y="949" width="840" height="113" />
        </mxCell>
        <mxCell id="fundamentals-51" parent="1" value="HTTP authorization" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#273543;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="938" y="962" width="804" height="30.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-52" parent="1" value="OAuth-based framework using existing metadata standards." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="938" y="1000" width="804" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-53" parent="1" value="OAuth 2.1 remains a draft; auth requirements depend on the scenario." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="938" y="1028" width="804" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-54" parent="1" value="" style="rounded=1;arcSize=8;fillColor=#FFFBF3;strokeColor=#A86B19;dashed=0;" vertex="1">
          <mxGeometry as="geometry" x="40" y="1098" width="1720" height="132" />
        </mxCell>
        <mxCell id="fundamentals-55" parent="1" value="Published standard ≠ every client's implemented version" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#A86B19;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="60" y="1115" width="1660" height="32.199999999999996" />
        </mxCell>
        <mxCell id="fundamentals-56" parent="1" value="Current core uses self-contained requests and per-request capabilities; older revisions use an initialize handshake." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="1158" width="1660" height="26.599999999999998" />
        </mxCell>
        <mxCell id="fundamentals-57" parent="1" value="The starter tests modern and legacy clients. Copilot documents DCR onboarding; newer OAuth guidance favors client metadata documents." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="1192" width="1660" height="25.2" />
        </mxCell>
        <mxCell id="fundamentals-58" parent="1" value="MCP complements REST / OpenAPI and model function calling; authorization, business rules and governance still need implementation." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#3178BF;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="40" y="1262" width="1700" height="26.599999999999998" />
        </mxCell>
        <mxCell id="fundamentals-59" parent="1" value="References: modelcontextprotocol.io/specification/latest · anthropic.com/news/model-context-protocol" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="40" y="1314" width="1700" height="22.4" />
        </mxCell>
      </root>
