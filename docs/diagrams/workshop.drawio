        <mxCell id="fundamentals-41" parent="1" value="Requests, results, errors and capability/version metadata." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
