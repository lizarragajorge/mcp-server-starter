        <mxCell id="fundamentals-43" parent="1" value="Transport bindings" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#273543;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="938" y="830" width="804" height="30.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-44" parent="1" value="Local: stdio. Remote: Streamable HTTP." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="938" y="868" width="804" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-45" parent="1" value="HTTPS protects remote traffic; legacy HTTP+SSE is different." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="938" y="896" width="804" height="23.799999999999997" />
