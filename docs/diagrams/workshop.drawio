        </mxCell>
        <mxCell id="fundamentals-30" parent="1" value="Why it gained adoption" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#273543;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="940" y="513" width="800" height="32.199999999999996" />
        </mxCell>
        <mxCell id="fundamentals-31" parent="1" value="A COMMON INDUSTRY INTERFACE · NOT THE ONLY OPTION" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#398E83;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="940" y="556" width="760" height="19.599999999999998" />
        </mxCell>
        <mxCell id="fundamentals-32" parent="1" value="One reusable interface across compatible AI hosts and servers." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="940" y="598" width="800" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-33" parent="1" value="Runtime discovery reduces bespoke tool wiring in each host." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="940" y="627" width="800" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-34" parent="1" value="SDKs, reference implementations and ecosystem support lower effort." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="940" y="656" width="800" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-35" parent="1" value="Works with existing APIs, business logic and identity platforms." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="940" y="685" width="800" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-36" parent="1" value="Widespread adoption is not universal support or guaranteed safety." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
