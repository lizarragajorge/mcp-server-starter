        <mxCell id="server-quality-37" parent="1" value="Treat login as authorization to every record or action." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
