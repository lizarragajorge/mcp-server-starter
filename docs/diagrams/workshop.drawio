        <mxCell id="fundamentals-23" parent="1" value="OPEN PROTOCOL · NOT AN AZURE PRODUCT" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#8658AD;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="60" y="556" width="760" height="19.599999999999998" />
        </mxCell>
        <mxCell id="fundamentals-24" parent="1" value="Created at Anthropic by David Soria Parra" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="598" width="800" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-25" parent="1" value="and Justin Spahr-Summers; introduced in November 2024." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="627" width="800" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-26" parent="1" value="Published as an open specification with SDKs and examples." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="656" width="800" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-27" parent="1" value="Inspired by Language Server Protocol's reusable interface pattern." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="685" width="800" height="23.799999999999997" />
        </mxCell>
        <mxCell id="fundamentals-28" parent="1" value="The protocol is not exclusive to Claude or any one model vendor." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#617182;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="60" y="714" width="800" height="23.799999999999997" />
